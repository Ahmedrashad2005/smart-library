# Shared environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
POSTGRES_DB=smart_library
POSTGRES_USER=smart_library
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://smart_library:change-me-for-local-development@postgres:5432/smart_library?schema=public

# Redis and services
REDIS_URL=redis://redis:6379
BACKEND_PORT=3000
FRONTEND_PORT=5173
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Phase 2 authentication configuration
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=smart_library_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
EMAIL_FROM=Smart Library <no-reply@smart-library.test>
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
